APP_NAME=Kafaat
APP_ENV=production
# APP_KEY مطلوب — يُولَّد عند النشر عبر: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.kafaat.qa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── قاعدة البيانات — مطلوب: عبّئ كل الحقول أدناه في الإنتاج ──
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── ADR-002: جلسة كوكيز httpOnly للويب · توكن Sanctum للجوال لاحقاً ──
# الواجهة والـ API يتشاركان نطاقاً أباً حتى تعمل كوكيز الجلسة.
# مطلوب: نطاقات الواجهة الحقيقية في الإنتاج (لا localhost).
SANCTUM_STATEFUL_DOMAINS=
# مطلوب: عنوان الواجهة الكامل. إن تُرِك فارغاً تعود إعادة توجيه الدفع و CORS
# إلى localhost بصمت — فتنكسر دورة الكشف والدفع في الإنتاج.
FRONTEND_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@kafaat.qa"
MAIL_FROM_NAME="${APP_NAME}"

# ── سرّ بوّابة الدفع (HMAC) لتوقيع الـ webhook والتحقّق منه ──
# مطلوب: سرّ قويّ وعشوائيّ — لا قيمة افتراضية في الإنتاج.
MANUAL_GATEWAY_SECRET=
